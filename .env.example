# ==============================================================================
# PrathamOne Academy Management System - Environment Configuration Template
# Copy this file to '.env' and update the values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prashant_academy
POSTGRES_PORT=5432

# Database connection URL for backend service
# In Docker Compose, the database host is 'db' (internal network)
# When connecting from local host outside Docker, use 'localhost:5432'
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prashant_academy

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# IMPORTANT: Generate a strong, random 64-character secret key for production!
# PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | % {[char]$_})
# Linux/macOS: openssl rand -hex 32
# ------------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# CORS / Allowed Client Origins (Comma-separated)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000,http://localhost

# ------------------------------------------------------------------------------
# Institute Defaults & Branding
# ------------------------------------------------------------------------------
INSTITUTION_NAME=Prashant Academy
INSTITUTION_CODE=PA001
DEFAULT_ACADEMIC_YEAR=2026-27
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
