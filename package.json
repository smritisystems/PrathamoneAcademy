{
  "name": "prashant-academy-workspace",
  "version": "1.9.0",
  "private": true,
  "description": "Prashant Academy Coaching Institute Management System - Monorepo Workspace",
  "scripts": {
    "headers:check": "python scripts/manage_headers.py check",
    "headers:fix": "python scripts/manage_headers.py fix",
    "version:auto": "python scripts/auto_version.py --sync",
    "version:status": "python scripts/auto_version.py --status",
    "version:bump": "python scripts/auto_version.py --bump",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "docker exec prashant_academy_backend pytest",
    "build:frontend": "npm --prefix frontend run build"
  },
